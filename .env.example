# ---------------------------------------------------------------------------
# Copy this file to .env and adjust. .env is gitignored and never shipped.
# ---------------------------------------------------------------------------

# Local Postgres installed via Homebrew (see README "Run without Docker")
DATABASE_URL=postgres://localhost:5432/sprintboard

# Local Postgres running under docker-compose instead
# DATABASE_URL=postgres://sprint:sprint@localhost:5433/sprintboard

# A remote Render database (note: PGSSL is required for these)
# DATABASE_URL=postgres://user:pass@host.render.com/dbname
# PGSSL=require

PORT=3000

# Set to false to create the schema without loading the demo rows
# SEED_ON_INIT=false

# Optional: restrict CORS origin. If unset, same-origin is allowed.
# CORS_ORIGIN=https://your-app.onrender.com
